{
  "name": "@bedr/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "build": "bun build src/server.ts --target bun --outdir dist",
    "start": "bun dist/server.js",
    "test": "bun test --preload ./test/setup.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/core/migrate.ts"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.3.3",
    "cookie": "^1.0.2",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.3.8",
    "jose": "^6.1.0"
  },
  "devDependencies": {
    "bun-types": "latest",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.3"
  }
}
