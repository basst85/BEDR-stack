{
  "name": "bedr",
  "private": true,
  "packageManager": "bun@1.3.14",
  "overrides": {
    "esbuild": "^0.28.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:frontend": "bun --cwd apps/frontend dev",
    "dev:backend": "bun --cwd apps/backend dev",
    "test": "bun --cwd apps/backend test",
    "test:backend": "bun --cwd apps/backend test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "start:backend": "bun --cwd apps/backend start",
    "start:frontend": "bun --cwd apps/frontend preview --host 0.0.0.0 --port 4173",
    "start": "bun run start:backend",
    "prod:backend": "bun --cwd apps/backend build && bun --cwd apps/backend start",
    "prod:frontend": "bun --cwd apps/frontend build && bun --cwd apps/frontend preview --host 0.0.0.0 --port 4173",
    "prod": "bun run build",
    "docker:prod": "docker compose up --build",
    "build": "bun --cwd packages/shared-client build && bun --cwd apps/backend build && bun --cwd apps/frontend build",
    "typecheck": "bun --cwd packages/shared-client typecheck && bun --cwd apps/backend typecheck && bun --cwd apps/frontend typecheck",
    "db:generate": "bun --cwd apps/backend db:generate",
    "db:migrate": "bun --cwd apps/backend db:migrate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "typescript-eslint": "^8.59.3"
  },
  "dependencies": {
    "prettier-plugin-tailwindcss": "^0.8.0"
  }
}
